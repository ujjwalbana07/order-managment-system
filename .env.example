DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-private-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=your-render-host.onrender.com
TRUST_HTTPS_PROXY=true
DATABASE_URL=postgresql://user:password@host:5432/database
RENDER_EXTERNAL_HOSTNAME=your-render-host.onrender.com
DJANGO_SECURE_SSL_REDIRECT=false
MEDIA_ROOT=/srv/oms/media
BACKUP_ROOT=/srv/oms/backups
USE_S3_STORAGE=false
AWS_ACCESS_KEY_ID=replace-if-using-s3-compatible-storage
AWS_SECRET_ACCESS_KEY=replace-if-using-s3-compatible-storage
AWS_STORAGE_BUCKET_NAME=replace-if-using-s3-compatible-storage
AWS_S3_ENDPOINT_URL=https://replace-if-using-s3-compatible-storage
AWS_S3_REGION_NAME=replace-if-using-s3-compatible-storage
AWS_S3_ADDRESSING_STYLE=path
