  "payment_cases": {
    "order": "sales_no 106 (gold 17760.30, diamond 10450.00, labour 2475.00, total 30685.30)",
    "steps": [
      {
        "do": "pay 10000.00 allocated gold 10000.00",
        "expect": {
          "gold_out": "7760.30",
          "diamond_out": "10450.00",
          "labour_out": "2475.00",
          "total_out": "20685.30",
          "status": "Partially Paid"
        }
      },
      {
        "do": "pay 20685.30 allocated gold 7760.30, diamond 10450.00, labour 2475.00",
        "expect": {
          "total_out": "0.00",
          "status": "Paid"
        }
      },
      {
        "do": "void first payment (reason required)",
        "expect": {
          "gold_out": "10000.00",
          "total_out": "10000.00",
          "status": "Partially Paid"
        }
      },
      {
        "do": "try pay 10000.00 allocated gold 9999.99",
        "expect": "rejected: allocations must equal amount"
      },
      {
