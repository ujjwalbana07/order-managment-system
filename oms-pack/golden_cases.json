{
  "rules": {
    "net_wt": "gross_wt - dia_ct/5 - other_wt",
    "pure_995": "net_wt * purity / 0.995 (full precision, never pre-rounded)",
    "gold_amount": "round_half_up(pure_995 * gold_rate, 2)",
    "labour_amount": "round_half_up(net_wt * lab_rate, 2)",
    "diamond_value": "round_half_up(input, 2)",
    "total_bill": "gold_amount + diamond_value + labour_amount (sum of already rounded components)",
    "net_earnings": "inr_sold - total_bill - ship_charges - platform_fees_inr (fees default 0)"
  },
